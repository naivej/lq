{
  "name": "lyx-preview",
  "displayName": "LyX Preview",
  "description": "Read-only Live preview of saved .lyx files.",
  "version": "0.1.0",
  "publisher": "naivej",
  "license": "MIT",
  "icon": "media/lyx-l.png",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    
  ],
  "contributes": {
    "languages": [
      {
        "id": "lyx",
        "aliases": [
          "LyX",
          "lyx"
        ],
        "extensions": [
          ".lyx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "lyx-preview.open",
        "title": "Open LyX Preview",
        "shortTitle": "Preview LyX",
        "icon": {
          "light": "media/lyx-l.svg",
          "dark": "media/lyx-l.svg"
        },
        "category": "LyX Preview"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "lyx-preview.open",
          "when": "resourceExtname == .lyx",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "lyx-preview.open",
          "when": "resourceExtname == .lyx"
        }
      ]
    },
    "configuration": {
      "title": "LyX Preview",
      "properties": {
        "lyx-preview.lqPath": {
          "type": "string",
          "default": "",
          "description": "Path to the compiled lq binary. When empty, the extension uses LQ_PATH, a workspace lq/bin binary, or lq on PATH."
        },
        "lyx-preview.timeoutMs": {
          "type": "number",
          "default": 30000,
          "description": "Milliseconds to wait for lq preview before terminating the process."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint .",
    "test": "npm run compile && node --test out/previewSession.test.js",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.125.0",
    "eslint": "^10.8.1",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}

{
  "name": "lyx-preview",
  "displayName": "LyX Preview",
  "description": "Read-only Live preview of saved .lyx files.",
  "version": "0.1.0",
  "publisher": "naivej",
  "license": "MIT",
  "icon": "media/lyx-l.png",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:lyx",
    "onCommand:lyx-preview.open",
    "workspaceContains:**/*.lyx"
  ],
  "contributes": {
    "languages": [
      {
        "id": "lyx",
        "aliases": [
          "LyX",
          "lyx"
        ],
        "extensions": [
          ".lyx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "lyx-preview.open",
        "title": "Open LyX Preview",
        "shortTitle": "Preview LyX",
        "icon": {
          "light": "media/lyx-l.svg",
          "dark": "media/lyx-l.svg"
        },
        "category": "LyX Preview"
      },
      {
        "command": "lyx-preview.revealOutline",
        "title": "Reveal Outline Heading",
        "category": "LyX Preview"
      },
      {
        "command": "lyx-preview.viewOriginal",
        "title": "Original",
        "category": "LyX Preview"
      },
      {
        "command": "lyx-preview.viewTracked",
        "title": "Tracked",
        "category": "LyX Preview"
      },
      {
        "command": "lyx-preview.viewClean",
        "title": "Clean",
        "category": "LyX Preview"
      },
      {
        "command": "lyx-preview.changeView",
        "title": "Change View",
        "icon": "media/lyx-l-yellow.svg",
        "category": "LyX Preview"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "lyxPreview.outline",
          "name": "LyX Navigate",
          "when": "lyxPreview.hasOutline || resourceExtname == .lyx",
          "contextualTitle": "LyX Navigate"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "lyx-preview.open",
          "when": "resourceExtname == .lyx",
          "group": "navigation"
        },
        {
          "command": "lyx-preview.changeView",
          "when": "activeWebviewPanelId == 'lyxPreview.live'",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "lyx-preview.open",
          "when": "resourceExtname == .lyx"
        },
        {
          "command": "lyx-preview.revealOutline",
          "when": "false"
        },
        {
          "command": "lyx-preview.viewOriginal",
          "when": "false"
        },
        {
          "command": "lyx-preview.viewTracked",
          "when": "false"
        },
        {
          "command": "lyx-preview.viewClean",
          "when": "false"
        },
        {
          "command": "lyx-preview.changeView",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "LyX Preview",
      "properties": {
        "lyx-preview.lqPath": {
          "type": "string",
          "default": "",
          "description": "Path to the compiled lq binary. The extension prefers the newest binary in the lq repo dev build directory, then this path, then lq on PATH."
        },
        "lyx-preview.timeoutMs": {
          "type": "number",
          "default": 30000,
          "description": "Milliseconds to wait for lq preview before terminating the process."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint .",
    "test": "npm run compile && node --test out/previewSession.test.js out/outlineProvider.test.js out/lqRunner.test.js out/webview.test.js",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.125.0",
    "eslint": "^10.8.1",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}

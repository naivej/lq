{
  "name": "lyx-preview",
  "displayName": "LyX Preview",
  "description": "Read-only Live preview of saved .lyx files.",
  "version": "0.1.3",
  "publisher": "CoconutWater",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/naivej/lq.git"
  },
  "homepage": "https://github.com/naivej/lq/tree/main/lyx_preview",
  "icon": "media/icon-vsd.png",
  "engines": {
    "vscode": "^1.96.0"
  },

  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.lyx"
  ],
  "contributes": {
    "languages": [
      {
        "id": "lyx",
        "aliases": [
          "LyX",
          "lyx"
        ],
        "extensions": [
          ".lyx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "lyx-preview.open",
        "title": "Open LyX Preview",
        "shortTitle": "LyX Preview",
        "icon": {
          "light": "media/lyx-l.svg",
          "dark": "media/lyx-l.svg"
        },
        "category": "LyX Preview"
      },
      {
        "command": "lyx-preview.revealOutline",
        "title": "Reveal in Preview",
        "category": "LyX Preview"
      },
      {
        "command": "lyx-preview.viewOriginal",
        "title": "Original",
        "category": "LyX Preview"
      },
      {
        "command": "lyx-preview.viewTracked",
        "title": "Tracked",
        "category": "LyX Preview"
      },
      {
        "command": "lyx-preview.viewClean",
        "title": "Clean",
        "category": "LyX Preview"
      },
      {
        "command": "lyx-preview.changeView",
        "title": "Tracked-change view",
        "icon": "media/lyx-l-yellow.svg",
        "category": "LyX Preview"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "lyxPreview.outline",
          "name": "LyX Outline",
          "when": "lyxPreview.hasOutline || resourceExtname == .lyx",
          "contextualTitle": "LyX Outline",
          "icon": "media/lyx-l.svg"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "lyx-preview.open",
          "when": "resourceExtname == .lyx",
          "group": "navigation"
        },
        {
          "command": "lyx-preview.changeView",
          "when": "activeWebviewPanelId == 'lyxPreview.live'",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "lyx-preview.open",
          "when": "resourceExtname == .lyx"
        },
        {
          "command": "lyx-preview.revealOutline",
          "when": "false"
        },
        {
          "command": "lyx-preview.viewOriginal",
          "when": "false"
        },
        {
          "command": "lyx-preview.viewTracked",
          "when": "false"
        },
        {
          "command": "lyx-preview.viewClean",
          "when": "false"
        },
        {
          "command": "lyx-preview.changeView",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "LyX Preview",
      "properties": {
        "lyx-preview.lqPath": {
          "type": "string",
          "default": "",
          "description": "LyX Preview will download and update the lq binary at this path. Leave empty to manage lq yourself."
        },
        "lyx-preview.timeoutMs": {
          "type": "number",
          "default": 30000,
          "description": "Milliseconds to wait for preview before terminating the process."
        }
      }
    },
    "languageModelTools": [
      {
        "name": "lyx-preview_get_live_selection",
        "displayName": "LyX Preview selection",
        "modelDescription": "Return the current LyX Preview selection as JSON (file, diskHash, stale, mode, selector, selectedText, changeId, multi, capturedAt, optional via). Use when the user refers to #lyxSelection or the preview caret/highlight. If nothing is selected, the result is 'no Preview selection'. The selector is a read reference, not a mutation selector.",
        "toolReferenceName": "lyxSelection",
        "canBeReferencedInPrompt": true,
        "when": "lyxPreview.liveOpen",
        "icon": "$(selection)",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint .",
    "test": "npm run compile && node --test out/fsPath.test.js out/previewSession.test.js out/outlineProvider.test.js out/lqRunner.test.js out/lqEnsure.test.js out/webview.test.js out/liveSelection.test.js",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/vscode": "~1.96.0",
    "@vscode/vsce": "^3.7.0",
    "eslint": "^10.8.1",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
